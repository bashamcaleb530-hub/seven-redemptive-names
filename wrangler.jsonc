{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redemptive-names-software",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-04",
  "secrets": {
    "required": [
      "OPENAI_API_KEY"
    ]
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}